# Copie este arquivo para .env.local e preencha com os dados do seu projeto no Supabase
# (painel do Supabase > Project Settings > API). O .env.local não vai para o GitHub.
# Sem essas duas linhas, o portal abre no modo demonstração.
#
# A "publishable key" (ou "anon key") pode ficar no navegador: quem protege os dados são
# as permissões do banco (supabase/schema.sql). Nunca coloque aqui a "secret/service_role key".
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
